# Copy to frontend/.env.local (gitignored) and fill in.
NEXT_PUBLIC_SUPABASE_URL=https://rnmjetheinheufqqsfeq.supabase.co
# Use the Supabase ANON key — NOT service_role. rls.sql grants public SELECT
# on all four tables, so Realtime works on anon and no write path opens up.
# The old committed service_role JWT is burned (git history) — rotate it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
# Shared secret for the gateway's /admin/* routes (queue-depth panel).
NEXT_PUBLIC_ADMIN_TOKEN=dev-admin-token
