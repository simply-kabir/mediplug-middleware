# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
STREAM_KEY=mediplug:cases
CONSUMER_GROUP=mediplug-workers
DLQ_STREAM_KEY=mediplug:cases:dlq
MAX_DELIVERY_ATTEMPTS=3
CLAIM_STALE_MS=60000

# --- Database ---
# On Supabase, use the transaction-mode pooler port (6543), not the
# session-mode port (5432) — session mode caps concurrent clients at the
# project's pool_size (often 15), which a gateway under real traffic will
# hit fast. Transaction mode is built for many short-lived connections.
DATABASE_URL=postgresql://postgres:mediplug@localhost:5432/mediplug
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Mapping ---
EMBEDDING_BACKEND=local          # local | api
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_KEY=
CONFIDENCE_AUTO_ACCEPT=0.82
CONFIDENCE_FLOOR=0.45

# --- Dispatch ---
DISPATCH_MODE=mock               # mock | nhcx
MOCK_PAYER_URL=http://localhost:8081

# --- NHCX (only used when DISPATCH_MODE=nhcx) ---
NHCX_BASE_URL=
NHCX_PARTICIPANT_CODE=
NHCX_USERNAME=
NHCX_PASSWORD=
NHCX_RECIPIENT_CODE=
NHCX_PRIVATE_KEY_PATH=
NHCX_PROTOCOL_VERSION=v0.7
